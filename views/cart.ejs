<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" type="text/css" href="/styles/general.css">
  <link rel="stylesheet" type="text/css" href="/styles/cart.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Lexend+Tera:wght@100..900&display=swap" rel="stylesheet">
  <link rel="icon" type="image/x-icon" href="/static/logo.svg">
  <title>Automaster</title>
  <script defer src="/js/sidebar.js"></script>
  <script defer src="/js/modal-cart.js"></script>
</head>
<body>
  <nav>

    <div id="overlay" class="overlay"></div>
    <div id="sidebar" class="sidebar">
      <div class="top-container">
        <svg class="back-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 15.75 3 12m0 0 3.75-3.75M3 12h18" />
        </svg>        
        <h2 class="title">Profile</h2>
      </div>
      <div class="bottom-container">
        <div class="profile-details-container">
          <div class="profile-detail">
            <div class="top">
              <label>Name</label>
              <!-- <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
              </svg>               -->
            </div>
            <div class="bottom"><%= user.charAt(0).toUpperCase() + user.slice(1) %></div>
          </div>
          <div class="profile-detail">
            <div class="top">
              <label>Email</label>
              <!-- <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
              </svg>               -->
            </div>
            <div class="bottom"><%= email %></div>
          </div>
          <div class="profile-detail">
            <div class="top">
              <label>Password</label>
              <!-- <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
              </svg>               -->
            </div>
            <div class="bottom">••••••••••</div>
          </div>
        </div>
      </div>
      <div class="log-out-container">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15m-3 0-3-3m0 0 3-3m-3 3H15" />
        </svg>          
        <a href="/users/logout">Logout</a>
      </div>
    </div>

    <div class="left">
      <a href="/users/dashboard"><img class="logo" src="/static/logo.svg"></a>
      <h2>AUTOMASTER</h2> 
    </div>
    <div class="middle">
      <div class="search-container">
        <input type="text" id="search" name="search" placeholder="Search">
        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-4">
          <path fill-rule="evenodd" d="M9.965 11.026a5 5 0 1 1 1.06-1.06l2.755 2.754a.75.75 0 1 1-1.06 1.06l-2.755-2.754ZM10.5 7a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z" clip-rule="evenodd" />
        </svg>        
      </div>
    </div>
    <div class="right">
      <a href="/users/cart">
        <svg class="cart-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
        </svg>
      </a>
      <svg id="profile-icon" class="profile-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
        <path fill-rule="evenodd" d="M18.685 19.097A9.723 9.723 0 0 0 21.75 12c0-5.385-4.365-9.75-9.75-9.75S2.25 6.615 2.25 12a9.723 9.723 0 0 0 3.065 7.097A9.716 9.716 0 0 0 12 21.75a9.716 9.716 0 0 0 6.685-2.653Zm-12.54-1.285A7.486 7.486 0 0 1 12 15a7.486 7.486 0 0 1 5.855 2.812A8.224 8.224 0 0 1 12 20.25a8.224 8.224 0 0 1-5.855-2.438ZM15.75 9a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" clip-rule="evenodd" />
      </svg>            
    </div>
  </nav>

  <main>
    <div class="main-top">
      <% if (recommendedProduct && correlatedName && reason) { %>
        <div class="ai-recommendation">
          <svg class="ai-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
            <path fill-rule="evenodd" d="M9 4.5a.75.75 0 0 1 .721.544l.813 2.846a3.75 3.75 0 0 0 2.576 2.576l2.846.813a.75.75 0 0 1 0 1.442l-2.846.813a3.75 3.75 0 0 0-2.576 2.576l-.813 2.846a.75.75 0 0 1-1.442 0l-.813-2.846a3.75 3.75 0 0 0-2.576-2.576l-2.846-.813a.75.75 0 0 1 0-1.442l2.846-.813A3.75 3.75 0 0 0 7.466 7.89l.813-2.846A.75.75 0 0 1 9 4.5ZM18 1.5a.75.75 0 0 1 .728.568l.258 1.036c.236.94.97 1.674 1.91 1.91l1.036.258a.75.75 0 0 1 0 1.456l-1.036.258c-.94.236-1.674.97-1.91 1.91l-.258 1.036a.75.75 0 0 1-1.456 0l-.258-1.036a2.625 2.625 0 0 0-1.91-1.91l-1.036-.258a.75.75 0 0 1 0-1.456l1.036-.258a2.625 2.625 0 0 0 1.91-1.91l.258-1.036A.75.75 0 0 1 18 1.5ZM16.5 15a.75.75 0 0 1 .712.513l.394 1.183c.15.447.5.799.948.948l1.183.395a.75.75 0 0 1 0 1.422l-1.183.395c-.447.15-.799.5-.948.948l-.395 1.183a.75.75 0 0 1-1.422 0l-.395-1.183a1.5 1.5 0 0 0-.948-.948l-1.183-.395a.75.75 0 0 1 0-1.422l1.183-.395c.447-.15.799-.5.948-.948l.395-1.183A.75.75 0 0 1 16.5 15Z" clip-rule="evenodd" />
          </svg>          
          <p>
            We noticed you have <strong><%= correlatedName %></strong> in your cart.  
            Perhaps you’d like to buy 
            <a href="/users/product/<%= recommendedProduct.id %>">
              <strong><%= recommendedProduct.name %></strong>
            </a> 
            for ₱<%= Number(recommendedProduct.price).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>?  
            <%= reason %>
          </p>
        </div>
      <% } %>
      
      
      <div class="products">
        <% if (cartItems.length > 0) { %>
          <% cartItems.forEach(item => { %>
            <div class="product">
              <div class="product-img">
                <img src="<%= item.image_path %>">
              </div>
              <div class="product-details">
                <div class="top">
                  <p class="product-name"><%= item.name %></p>
                  <form action="/cart/remove" method="POST">
                    <input type="hidden" name="product_id" value="<%= item.product_id ? item.product_id : '' %>">
                    <button type="submit" class="x-icon">x</button>
                  </form>
                </div>
                <div class="bottom">
                  <p class="product-price">₱<%= Number(item.price).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></p>
                  <div class="product-counter">
                    <form action="/cart/update" method="POST">
                      <input type="hidden" name="product_id" value="<%= item.product_id %>">
                      <button type="submit" name="action" value="decrease" class="product-decrease">-</button>
                    </form>
                    <p class="product-count"><%= item.quantity %></p>
                    <form action="/cart/update" method="POST">
                      <input type="hidden" name="product_id" value="<%= item.product_id %>">
                      <button type="submit" name="action" value="increase" class="product-increase">+</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>        
        <% } else { %>
          <p class="empty">Your cart is empty.</p>
        <% } %>
      </div>
    
      <div class="payment-container">
        <div class="payment-details">
          <div class="subtotal">
            <p>Subtotal:</p>
            <p>₱<%= cartItems.reduce((total, item) => total + (item.price * item.quantity), 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></p>
          </div>
          <div class="delivery-fee">
            <p>Delivery Fee:</p>
            <p>
              ₱<%= cartItems.length > 0 ? "50.00" : "0.00" %>
            </p>
          </div>
          <div class="total">
            <p>Total:</p>
            <p>
              ₱<%= (
                cartItems.reduce((total, item) => total + (item.price * item.quantity), 0) 
                + (cartItems.length > 0 ? 50 : 0)
              ).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
            </p>
          </div>
          
        </div>
      </div>
    </div>
    <button class="checkout-btn" <%= cartItems.length === 0 ? "disabled" : "" %>>Checkout</button>
  </main>
  

  <div id="confirmationModal" class="modal">
    <div class="modal-content">
        <p>Are you sure you want to purchase the items in your cart?</p>
        <div class="btns-container">
          <button id="confirmBtn">Confirm</button>
          <button id="cancelBtn">Cancel</button>
        </div>
    </div>
  </div>
  <div id="thankYouModal" class="modal">
    <div class="modal-content">
      <p class="thank-you-msg">Thank you for your purchase!</p>
      <div class="details">
        <div class="order">
          <div class="order-date">
            <p class="order-date-name">Order Date:</p>
            <p class="order-date-value">
              <%= new Date().toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" }) %>
            </p>
          </div>
          <div class="order-total">
            <p class="order-total-name">Order Total:</p>
            <p class="order-total-value">
              ₱<%= (
                cartItems.reduce((total, item) => total + (item.price * item.quantity), 0) 
                + (cartItems.length > 0 ? 50 : 0) 
              ).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
            </p>            
          </div>
        </div>
        <div class="item-list">
          <p class="items-title">Items:</p>
          <% cartItems.forEach(item => { %>
            <div class="item">
              <p><%= item.name %> (<%= item.quantity %>)</p>
              <p>₱<%= (item.price * item.quantity).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></p>
            </div>
          <% }) %>
        </div>
      </div>
      <form action="/cart/clear" method="POST">
        <button type="submit" class="continue-shopping-btn">Continue Shopping</button>
      </form>
    </div>
  </div>
  
</body>
</html>